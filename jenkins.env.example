# Copy this file to jenkins.env on the EC2 instance and fill in your values.
# scripts/setup-ec2.sh installs it to /opt/pulsechat/jenkins.env, where
# scripts/seed-jenkins.groovy reads it on every Jenkins start.
#
# NEVER commit the filled-in copy. It is in .gitignore.

# ---------------------------------------------------------------------------
# AWS credentials for Amazon ECR (IAM user access key)
# Create: IAM -> Users -> Create user -> attach AmazonEC2ContainerRegistryFullAccess
#         -> Security credentials -> Create access key
# The region must match your EC2 instance (Mumbai = ap-south-1).
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=wJalrxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
ECR_REPO=pulsechat

# GitHub repository that holds this project
PULSE_REPO=https://github.com/yourgithubuser/cloud_cca2.git
PULSE_BRANCH=main

# Optional overrides
ECR_CREDS_ID=ecr-creds
JOB_NAME=pulsechat-pipeline